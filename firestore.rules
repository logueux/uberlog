rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les demandes sont rangées sous un code d'accès secret : postes/<CODE>/demandes/<id>.
    // Sans le code, impossible de lister ou de lire quoi que ce soit (la liste des codes n'est pas lisible).
    match /postes/{code}/demandes/{id} {
      allow get, list: if code.size() >= 20;
      allow create, update: if code.size() >= 20
        && request.resource.data.type in ['RAV', 'MEC', 'SAN']
        && request.resource.data.cie in ['bleu', 'furieux', 'jonquille', 'vert', 'noir']
        && request.resource.data.statut in ['EMISE', 'PREPARATION', 'EN_ROUTE', 'LIVREE', 'REFUSEE', 'ANNULEE'];
      allow delete: if false;
    }
  }
}
